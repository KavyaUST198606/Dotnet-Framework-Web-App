<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!-- Optional private feed (Azure Artifacts, ProGet, Nexus, MyGet, etc.)
    <add key="CompanyFeed" value="https://pkgs.example.com/nuget/v3/index.json" protocolVersion="3" />
    -->
  </packageSources>

  <!-- Only needed if the private feed requires a login.
       Do NOT put real passwords here. Use TeamCity parameters instead.
  <packageSourceCredentials>
    <CompanyFeed>
      <add key="Username" value="%FEED_USER%" />
      <add key="ClearTextPassword" value="%FEED_PASSWORD%" />
    </CompanyFeed>
  </packageSourceCredentials>
  -->

  <config>
    <add key="repositoryPath" value="packages" />
  </config>

  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
</configuration>